{
  "model": "opus",
  "effortLevel": "high",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.tools/md-to-html.js\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.tools/proto-frame.js\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.tools/proto-shot.js\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.tools/md-to-html.js\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.tools/proto-frame.js\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.tools/hydra-bilan.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.tools/hydra-qa-gate.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.tools/hydra-bilan.js\""
          }
        ]
      },
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.tools/hydra-cles-garde.js\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.tools/hydra-cles.js\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node .tools/hydra-api.js:*)",
      "Bash(node \"$CLAUDE_PROJECT_DIR/.tools/hydra-api.js\":*)",
      "Bash(node .tools/hydra-cles-preparer.js:*)",
      "Bash(node \"$CLAUDE_PROJECT_DIR/.tools/hydra-cles-preparer.js\":*)"
    ]
  }
}
